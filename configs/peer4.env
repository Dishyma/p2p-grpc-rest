# Configuración Peer 4
PEER_NAME=peer_4
PEER_PASSWORD=peer123
PEER_IP=0.0.0.0
# Puertos gRPC separados por microservicio
GRPC_DOWNLOAD_PORT=50054
GRPC_UPLOAD_PORT=50064
GRPC_LIST_PORT=50074
REST_PORT=8004
FILES_DIRECTORY=./data/peer4_files
DIRECTORY_SERVER_URL=http://directory_server:8080/api/v1
