FROM python:3.13-slim

WORKDIR /app

# Dependencias del sistema
RUN apt-get update && apt-get install -y build-essential libpq-dev && rm -rf /var/lib/apt/lists/*

# Copiar Pipfiles
COPY Pipfile Pipfile.lock ./

# Instalar pipenv y dependencias
RUN pip install --no-cache-dir pipenv && pipenv install --deploy --system --dev

# Copiar código
COPY src ./src

# Asegurar que Python encuentre los módulos en src
ENV PYTHONPATH=/app/src

# Generar código gRPC (idempotente)
RUN python -m src.proto.generate || true

# Comando por defecto (puede ser sobreescrito por compose)
CMD ["python", "-m", "src.peer.main"]
